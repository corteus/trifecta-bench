  "findings": [
    {
      "rule_id": "TRIFLOW-TRIFECTA",
      "finding_type": "lethal_trifecta",
      "severity": "critical",
      "title": "Lethal trifecta present within a single server: trifecta-bench:playwright/browser_run_code_unsafe [private_data_source] \u2192 trifecta-bench:playwright/browser_close [untrusted_content_ingress] \u2192 trifecta-bench:playwright/browser_run_code_unsafe [exfiltration_channel]",
      "detail": "The installed fleet jointly satisfies the lethal trifecta within a single server: a tool that reads private data, a tool that ingests attacker-influenceable content, and a tool that can send data outside. Injected instructions in the ingested content can drive the private-data tool and then the exfiltration tool. Representative chain: trifecta-bench:playwright/browser_run_code_unsafe [private_data_source] \u2192 trifecta-bench:playwright/browser_close [untrusted_content_ingress] \u2192 trifecta-bench:playwright/browser_run_code_unsafe [exfiltration_channel]. (+18 more untrusted-content ingress tools)",
      "remediation": "Break at least one leg for the agent that can reach all three: remove or scope down the exfiltration tool, isolate the untrusted-ingress server into a separate agent/session, or gate private-data reads behind human approval. The three capabilities must not be reachable together.",
